# Database
DATABASE_URL=sqlite+aiosqlite:///./salestorm.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://salestorm:salestorm_password@localhost:5432/salestorm

# Redis
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USE_KAFKA=false

# Reservation Settings
RESERVATION_TTL_SECONDS=30
